# Copy to .env and adjust for local/Docker runs.
SECRET_KEY_BASE=please_change_me_to_a_long_random_string_at_least_64_chars_xxxxxxxx
FORCE_SSL=false
ASSUME_SSL=false

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme123
SUPERADMIN_FULL_NAME=Super Admin

# Local Postgres (docker compose db on localhost:5432)
POSTGRES_HOST=localhost
POSTGRES_USER=dlm
POSTGRES_PASSWORD=dlm
POSTGRES_DB=dlm_development

# Public QR/links base URL (no trailing slash). Optional in local; set in cloud.
# Example: https://dlm.example.com
# PUBLIC_BASE_URL=

# Used by docker compose (db + web). Override if needed.
# DATABASE_URL=postgres://dlm:dlm@db:5432/dlm_production
# Active Storage Disk root inside the container (compose sets this)
# ACTIVE_STORAGE_ROOT=/rails/storage
# Host directory bind-mounted to /rails/storage (photos). Example: D:/dlm/storage
HOST_STORAGE_PATH=./storage

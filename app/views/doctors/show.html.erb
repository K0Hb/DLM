<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold"><%= @record.full_name %></h1>
    <p class="text-sm text-slate-600">Врач · <%= @record.active? ? "активен" : "неактивен" %></p>
  </div>
  <div class="flex flex-wrap gap-3 text-sm">
    <%= link_to "Изменить", edit_doctor_path(@record), class: "rounded border px-3 py-1" %>
    <%= link_to "К списку", doctors_path, class: "underline px-2 py-1" %>
  </div>
</div>

<div class="mb-8 grid gap-2 text-sm md:grid-cols-2 max-w-3xl">
  <div>Заказчик: <%= @record.customer ? link_to(@record.customer.name, customer_path(@record.customer), class: "underline") : "—" %></div>
  <div>Телефон: <%= @record.phone.presence || "—" %></div>
  <div class="md:col-span-2">
    <div class="font-medium">Заметки</div>
    <div class="mt-1 whitespace-pre-wrap text-slate-700"><%= @record.notes.presence || "—" %></div>
  </div>
</div>

<div class="mb-8">
  <h2 class="mb-3 text-lg font-semibold">Пациенты</h2>
  <table class="w-full border-collapse text-left text-sm">
    <thead>
      <tr class="border-b text-slate-500">
        <th class="py-2 pr-3">ФИО</th>
        <th class="py-2 pr-3">Нарядов</th>
        <th class="py-2 pr-3"></th>
      </tr>
    </thead>
    <tbody>
      <% if @patients.empty? %>
        <tr><td colspan="3" class="py-6 text-slate-500">Пациентов нет</td></tr>
      <% else %>
        <% @patients.each do |patient| %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="py-2 pr-3"><%= record_link(patient.full_name, patient_path(patient)) %></td>
            <td class="py-2 pr-3"><%= patient.work_orders.size %></td>
            <td class="py-2 pr-3 text-right"><%= open_record_link(patient_path(patient)) %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<div>
  <h2 class="mb-3 text-lg font-semibold">Наряды</h2>
  <table class="w-full border-collapse text-left text-sm">
    <thead>
      <tr class="border-b text-slate-500">
        <th class="py-2 pr-3">№</th>
        <th class="py-2 pr-3">Статус</th>
        <th class="py-2 pr-3">Заказчик</th>
        <th class="py-2 pr-3">Пациент</th>
        <th class="py-2 pr-3">Срок</th>
        <th class="py-2 pr-3"></th>
      </tr>
    </thead>
    <tbody>
      <% if @work_orders.empty? %>
        <tr><td colspan="6" class="py-6 text-slate-500">Нарядов нет</td></tr>
      <% else %>
        <% @work_orders.each do |order| %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="py-2 pr-3"><%= record_link("##{order.number}", work_order_path(order)) %></td>
            <td class="py-2 pr-3"><%= work_order_status_badge(order) %></td>
            <td class="py-2 pr-3"><%= order.customer.name %></td>
            <td class="py-2 pr-3"><%= order.patient&.full_name || "—" %></td>
            <td class="py-2 pr-3"><%= order.due_at&.strftime("%d.%m.%Y") || "—" %></td>
            <td class="py-2 pr-3 text-right"><%= open_record_link(work_order_path(order)) %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

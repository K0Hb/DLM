<h1 class="mb-6 text-2xl font-semibold"><%= @record.persisted? ? "Изменить врача" : "Новый врач" %></h1>
<%= form_with model: @record, class: "max-w-lg space-y-4" do |f| %>
  <% if @record.errors.any? %>
    <div class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800">
      <ul class="list-disc pl-4"><% @record.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= f.label :full_name, "ФИО", class: "block text-sm font-medium" %>
    <%= f.text_field :full_name, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :customer_id, "Заказчик (опционально)", class: "block text-sm font-medium" %>
    <%= f.collection_select :customer_id, Customer.order(:name), :id, :name, { include_blank: "—" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :phone, "Телефон", class: "block text-sm font-medium" %>
    <%= f.text_field :phone, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :notes, "Заметки", class: "block text-sm font-medium" %>
    <%= f.text_area :notes, rows: 3, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div class="flex items-center gap-2"><%= f.check_box :active %><%= f.label :active, "Активен" %></div>
  <div class="flex gap-3">
    <%= f.submit "Сохранить", class: "rounded bg-slate-900 px-4 py-2 text-sm text-white" %>
    <%= link_to "Отмена", (@record.persisted? ? doctor_path(@record) : doctors_path), class: "underline text-sm" %>
  </div>
<% end %>

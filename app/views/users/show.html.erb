<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold"><%= @user.full_name %></h1>
    <p class="text-sm text-slate-600"><%= user_role_label(@user.role) %> · <%= @user.active? ? "активен" : "неактивен" %></p>
  </div>
  <div class="flex flex-wrap gap-3 text-sm">
    <% if policy(@user).update? %>
      <%= link_to "Изменить", edit_user_path(@user), class: "rounded border px-3 py-1" %>
    <% end %>
    <%= link_to "К списку", users_path, class: "underline px-2 py-1" %>
  </div>
</div>

<div class="mb-8 grid gap-2 text-sm md:grid-cols-2 max-w-3xl">
  <div>Email: <%= @user.email %></div>
  <div>Роль: <%= user_role_label(@user.role) %></div>
  <% if @pool_services.present? %>
    <div class="md:col-span-2">
      <div class="font-medium">Пул услуг</div>
      <div class="mt-1 text-slate-700">
        <% if @pool_services.any? %>
          <%= @pool_services.map(&:name).join(", ") %>
        <% else %>
          —
        <% end %>
      </div>
      <% if policy(@user).update? %>
        <div class="mt-2">
          <%= link_to "Изменить пул", edit_employee_skill_path(@user), class: "text-sm underline" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="mb-6 flex flex-wrap gap-4 text-sm">
  <% @status_counts.each do |status, count| %>
    <div class="rounded border border-slate-200 px-3 py-2">
      <%= service_line_status_badge(status) %>
      <span class="ml-2 font-medium"><%= count %></span>
    </div>
  <% end %>
</div>

<div class="mb-6">
  <h2 class="mb-2 text-lg font-semibold">Назначенные услуги</h2>
  <p class="text-sm text-slate-600">
    Выполнено (в выборке): <strong><%= number_to_currency(@completed_sum) %></strong>
    · оплачено: <strong class="text-emerald-700"><%= number_to_currency(@paid_sum) %></strong>
    · не оплачено: <strong class="text-red-700"><%= number_to_currency(@unpaid_sum) %></strong>
  </p>
</div>

<%= form_with url: user_path(@user), method: :get, class: "mb-6 flex flex-wrap items-end gap-3 text-sm" do %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="status">Статус</label>
    <%= select_tag :status,
                   options_for_select(service_line_status_options(include_blank: "Все"), params[:status]),
                   id: "status",
                   class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="paid">Оплата сотруднику</label>
    <%= select_tag :paid,
                   options_for_select([["Все", ""], ["Оплачено", "yes"], ["Не оплачено", "no"]], params[:paid]),
                   id: "paid",
                   class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="from">С</label>
    <%= date_field_tag :from, params[:from], id: "from", class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="to">По</label>
    <%= date_field_tag :to, params[:to], id: "to", class: "rounded border px-2 py-1" %>
  </div>
  <%= submit_tag "Фильтр", class: "rounded bg-slate-800 px-3 py-1 text-white" %>
  <%= link_to "Сбросить", user_path(@user), class: "underline self-center" %>
<% end %>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b border-slate-200 text-slate-500">
      <th class="py-2 pr-3">Наряд</th>
      <th class="py-2 pr-3">Заказчик</th>
      <th class="py-2 pr-3">Пациент</th>
      <th class="py-2 pr-3">Услуга</th>
      <th class="py-2 pr-3">Кол-во</th>
      <th class="py-2 pr-3">Статус</th>
      <th class="py-2 pr-3">Оплата</th>
      <th class="py-2 pr-3">Срок</th>
      <th class="py-2 pr-3">Сумма</th>
      <th class="py-2 pr-3"></th>
    </tr>
  </thead>
  <tbody>
    <% if @lines.empty? %>
      <tr><td colspan="10" class="py-6 text-slate-500">Назначенных услуг нет</td></tr>
    <% else %>
      <% @lines.each do |line| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="py-2 pr-3"><%= record_link("##{line.work_order.number}", work_order_path(line.work_order)) %></td>
          <td class="py-2 pr-3"><%= line.work_order.customer.name %></td>
          <td class="py-2 pr-3"><%= line.work_order.patient&.full_name || "—" %></td>
          <td class="py-2 pr-3"><%= line.service.name %></td>
          <td class="py-2 pr-3"><%= line.quantity %></td>
          <td class="py-2 pr-3"><%= service_line_status_badge(line) %></td>
          <td class="py-2 pr-3"><%= technician_paid_badge(line) %></td>
          <td class="py-2 pr-3"><%= line.work_order.due_at&.strftime("%d.%m.%Y") || "—" %></td>
          <td class="py-2 pr-3"><%= number_to_currency(line.amount) %></td>
          <td class="py-2 pr-3 text-right"><%= open_record_link(work_order_path(line.work_order)) %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<div class="mb-6 flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">Пользователи</h1>
  <%= link_to "Новый пользователь", new_user_path, class: "rounded bg-slate-900 px-3 py-2 text-sm text-white" %>
</div>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b border-slate-200 text-slate-500">
      <th class="py-2 pr-3">ФИО</th>
      <th class="py-2 pr-3">Email</th>
      <th class="py-2 pr-3">Роль</th>
      <th class="py-2 pr-3">Активен</th>
      <th class="py-2"></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr class="border-b border-slate-100 hover:bg-slate-50">
        <td class="py-2 pr-3"><%= record_link(user.full_name, user_path(user)) %></td>
        <td class="py-2 pr-3"><%= user.email %></td>
        <td class="py-2 pr-3"><%= user_role_label(user.role) %></td>
        <td class="py-2 pr-3"><%= user.active? ? "да" : "нет" %></td>
        <td class="py-2 pr-3 text-right"><%= open_record_link(user_path(user)) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mx-auto max-w-md space-y-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold">Вход в DLM</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "Email", class: "block text-sm font-medium" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
    </div>

    <div>
      <%= f.label :password, "Пароль", class: "block text-sm font-medium" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2 text-sm">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "Запомнить меня" %>
      </div>
    <% end %>

    <div>
      <%= f.submit "Войти", class: "w-full rounded bg-slate-900 px-4 py-2 text-white" %>
    </div>
  <% end %>
</div>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold">По заказчикам за период</h1>
    <p class="text-sm text-slate-600">По дате создания наряда: сколько заказов, сколько уже оплатили и сколько должны.</p>
  </div>
  <%= link_to "Ко всем отчётам", reports_path, class: "underline text-sm" %>
</div>

<%= form_with url: reports_customers_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3 text-sm" do %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="from">С</label>
    <%= date_field_tag :from, @from, id: "from", class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="to">По</label>
    <%= date_field_tag :to, @to, id: "to", class: "rounded border px-2 py-1" %>
  </div>
  <%= submit_tag "Показать", class: "rounded bg-slate-800 px-3 py-1 text-white" %>
<% end %>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b text-slate-500">
      <th class="py-2 pr-3">Заказчик</th>
      <th class="py-2 pr-3">Нарядов</th>
      <th class="py-2 pr-3">Оплачено</th>
      <th class="py-2 pr-3">Долг</th>
      <th class="py-2 pr-3">Всего (оплачено + долг)</th>
      <th class="py-2 pr-3"></th>
    </tr>
  </thead>
  <tbody>
    <% if @rows.empty? %>
      <tr><td colspan="6" class="py-6 text-slate-500">Нет нарядов за период</td></tr>
    <% else %>
      <% @rows.each do |row| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="py-2 pr-3"><%= record_link(row[:customer].name, customer_path(row[:customer])) %></td>
          <td class="py-2 pr-3"><%= row[:orders_count] %></td>
          <td class="py-2 pr-3"><%= number_to_currency(row[:paid_sum]) %></td>
          <td class="py-2 pr-3 <%= "font-medium text-red-700" if row[:debt_sum].positive? %>"><%= number_to_currency(row[:debt_sum]) %></td>
          <td class="py-2 pr-3"><%= number_to_currency(row[:due_sum]) %></td>
          <td class="py-2 pr-3 text-right space-x-2">
            <%= link_to "Наряды", work_orders_path(customer_id: row[:customer].id), class: "underline text-xs" %>
            <% if row[:debt_sum].positive? %>
              <%= link_to "Долг", reports_unpaid_path(customer_id: row[:customer].id), class: "underline text-xs" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<% if @rows.any? %>
  <p class="mt-4 text-sm font-medium">
    Итого на странице:
    <%= @rows.sum { |r| r[:orders_count] } %> наряд(ов)
    · оплачено <%= number_to_currency(@rows.sum { |r| r[:paid_sum] }) %>
    · долг <%= number_to_currency(@rows.sum { |r| r[:debt_sum] }) %>
  </p>
<% end %>

<%= render_pagination %>

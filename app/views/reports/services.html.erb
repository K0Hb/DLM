<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold">По услугам за период</h1>
    <p class="text-sm text-slate-600">По дате выполнения услуги: объём и сумма начислений техникам (как в отчёте начислений).</p>
  </div>
  <%= link_to "Ко всем отчётам", reports_path, class: "underline text-sm" %>
</div>

<%= form_with url: reports_services_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3 text-sm" do %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="from">С</label>
    <%= date_field_tag :from, @from, id: "from", class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="to">По</label>
    <%= date_field_tag :to, @to, id: "to", class: "rounded border px-2 py-1" %>
  </div>
  <%= submit_tag "Показать", class: "rounded bg-slate-800 px-3 py-1 text-white" %>
<% end %>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b text-slate-500">
      <th class="py-2 pr-3">Услуга</th>
      <th class="py-2 pr-3">Строк</th>
      <th class="py-2 pr-3">Количество</th>
      <th class="py-2 pr-3">Начислено</th>
      <th class="py-2 pr-3"></th>
    </tr>
  </thead>
  <tbody>
    <% if @rows.empty? %>
      <tr><td colspan="5" class="py-6 text-slate-500">Нет выполненных услуг за период</td></tr>
    <% else %>
      <% @rows.each do |row| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="py-2 pr-3"><%= record_link(row[:service].name, service_path(row[:service])) %></td>
          <td class="py-2 pr-3"><%= row[:lines_count] %></td>
          <td class="py-2 pr-3"><%= row[:quantity] %></td>
          <td class="py-2 pr-3"><%= number_to_currency(row[:amount]) %></td>
          <td class="py-2 pr-3 text-right">
            <%= link_to "В начислениях",
                        reports_payroll_path(from: @from, to: @to, service_id: row[:service].id),
                        class: "underline text-xs" %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<% if @rows.any? %>
  <p class="mt-4 text-sm font-medium">
    Итого на странице: <%= @rows.sum { |r| r[:quantity] } %> шт. ·
    <%= number_to_currency(@rows.sum { |r| r[:amount] }) %>
  </p>
<% end %>

<%= render_pagination %>

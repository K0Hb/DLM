<div class="mb-6">
  <h1 class="text-2xl font-semibold">Журнал выплат сотрудникам</h1>
  <p class="mt-1 text-sm text-slate-600">Только факты фиксации. Записи не редактируются.</p>
</div>

<%= render "shared/payment_event_tabs", active: :technician %>

<div class="mb-4 flex flex-wrap justify-end gap-3 text-sm">
  <% if current_user.admin_or_superadmin? %>
    <%= link_to "К оплатам сотрудникам", technician_payouts_path, class: "underline" %>
  <% end %>
</div>

<%= form_with url: payment_events_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3 text-sm" do %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="event_type">Тип</label>
    <%= select_tag :event_type,
                   options_for_select([["Все", ""]] + %w[technician_paid technician_unpaid].map { |t| [PaymentEvent.new(event_type: t).label, t] }, params[:event_type]),
                   id: "event_type", class: "rounded border px-2 py-1" %>
  </div>
  <% if @employees %>
    <div>
      <label class="mb-1 block text-xs text-slate-500" for="assignee_id">Исполнитель</label>
      <%= select_tag :assignee_id,
                     options_from_collection_for_select(@employees, :id, :full_name, params[:assignee_id]),
                     include_blank: "Все",
                     id: "assignee_id", class: "rounded border px-2 py-1" %>
    </div>
  <% end %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="from">С</label>
    <%= date_field_tag :from, params[:from], id: "from", class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="to">По</label>
    <%= date_field_tag :to, params[:to], id: "to", class: "rounded border px-2 py-1" %>
  </div>
  <%= submit_tag "Фильтр", class: "rounded bg-slate-800 px-3 py-1 text-white" %>
<% end %>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b text-slate-500">
      <th class="py-2 pr-2">Когда</th>
      <th class="py-2 pr-2">Событие</th>
      <th class="py-2 pr-2">Кто</th>
      <th class="py-2 pr-2">Объект</th>
      <th class="py-2 pr-2">Сумма</th>
      <th class="py-2 pr-2">Коммент.</th>
      <th class="py-2 pr-2"></th>
    </tr>
  </thead>
  <tbody>
    <% if @events.empty? %>
      <tr><td colspan="7" class="py-6 text-slate-500">Событий нет</td></tr>
    <% else %>
      <% @events.each do |event| %>
        <tr class="border-b border-slate-100">
          <td class="py-2 pr-2 whitespace-nowrap"><%= event.created_at.strftime("%d.%m.%Y %H:%M") %></td>
          <td class="py-2 pr-2"><%= event.label %></td>
          <td class="py-2 pr-2"><%= event.actor.full_name %></td>
          <td class="py-2 pr-2">
            <% if event.work_order_service %>
              Услуга <%= event.work_order_service.service.name %> · наряд #<%= event.work_order&.number || event.work_order_service.work_order.number %>
              · <%= event.work_order_service.assignee.full_name %>
            <% else %>
              —
            <% end %>
          </td>
          <td class="py-2 pr-2"><%= number_to_currency(event.amount) %></td>
          <td class="py-2 pr-2"><%= event.note.presence || "—" %></td>
          <td class="py-2 pr-2 text-right">
            <% order = event.work_order_service&.work_order %>
            <% if order %>
              <%= open_record_link(work_order_path(order)) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

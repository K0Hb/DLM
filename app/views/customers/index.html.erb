<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">Заказчики</h1>
  <%= link_to "Добавить", new_customer_path, class: "rounded bg-slate-900 px-3 py-2 text-sm text-white" %>
</div>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b border-slate-200 text-slate-500">
      <th class="py-2 pr-3">Название</th>
      <th class="py-2 pr-3">Телефон</th>
      <th class="py-2 pr-3">Нарядов</th>
      <th class="py-2 pr-3">Не оплачено</th>
      <th class="py-2 pr-3">Активен</th>
      <th class="py-2"></th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <% unpaid = record.work_orders.count { |o| !o.customer_paid? } %>
      <tr class="border-b border-slate-100 hover:bg-slate-50">
        <td class="py-2 pr-3"><%= record_link(record.name, customer_path(record)) %></td>
        <td class="py-2 pr-3"><%= record.phone.presence || "—" %></td>
        <td class="py-2 pr-3"><%= record.work_orders.size %></td>
        <td class="py-2 pr-3">
          <% if unpaid.positive? %>
            <%= link_to unpaid, customer_payment_orders_path(customer_id: record.id, paid: "no"), class: "font-medium text-red-700 underline" %>
          <% else %>
            0
          <% end %>
        </td>
        <td class="py-2 pr-3"><%= record.active? ? "да" : "нет" %></td>
        <td class="py-2 pr-3 text-right space-x-2">
          <%= open_record_link(customer_path(record)) %>
          <% if unpaid.positive? %>
            <%= link_to "Оплаты", customer_payment_orders_path(customer_id: record.id, paid: "no"), class: "underline text-xs" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

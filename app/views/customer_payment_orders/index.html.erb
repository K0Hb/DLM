<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Оплаты заказчиков</h1>
    <p class="text-sm text-slate-600">
      Наряды и статус оплаты заказчиком. Отметьте галочками и перейдите к подтверждению.
    </p>
  </div>
  <%= link_to "Журналы", customer_payment_events_path, class: "text-sm underline" %>
</div>

<%= form_with url: customer_payment_orders_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3 text-sm" do %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="customer_id">Заказчик</label>
    <%= select_tag :customer_id,
                   options_from_collection_for_select(@customers, :id, :name, params[:customer_id]),
                   include_blank: "Все",
                   id: "customer_id",
                   class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="paid">Оплата</label>
    <%= select_tag :paid,
                   options_for_select([["Не оплачен", "no"], ["Оплачен", "yes"], ["Все", ""]], params[:paid].presence || "no"),
                   id: "paid",
                   class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="status">Статус наряда</label>
    <%= select_tag :status,
                   options_for_select(work_order_status_options(include_blank: "Все"), params[:status]),
                   id: "status",
                   class: "rounded border px-2 py-1" %>
  </div>
  <%= submit_tag "Фильтр", class: "rounded bg-slate-800 px-3 py-1 text-white" %>
  <% if params[:customer_id].present? || params[:status].present? || (params[:paid].present? && params[:paid] != "no") %>
    <%= link_to "Сбросить", customer_payment_orders_path, class: "underline self-center" %>
  <% end %>
<% end %>

<% if @orders.empty? %>
  <p class="text-sm text-slate-500">Нарядов по фильтру нет.</p>
<% else %>
  <%= form_with url: new_customer_payment_path, method: :get,
                class: "space-y-4 text-sm",
                data: { controller: "payment-line-select" } do %>
    <%= hidden_field_tag :paid, @batch_paid %>
    <%= hidden_field_tag :return_to, customer_payment_orders_path(customer_id: params[:customer_id], paid: params[:paid], status: params[:status]) %>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-3">
        <button type="button" data-action="payment-line-select#checkAll" class="underline">Отметить все</button>
        <button type="button" data-action="payment-line-select#uncheckAll" class="underline">Снять все</button>
      </div>
      <p class="text-slate-600">
        Нарядов: <strong><%= @orders.size %></strong>
        · сумма оплаты в списке: <strong><%= number_to_currency(@total_payment_amount) %></strong>
        · отмечено: <strong data-payment-line-select-target="total"><%= number_to_currency(0) %></strong>
      </p>
    </div>

    <table class="w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-slate-500">
          <th class="py-2 pr-2 w-10"></th>
          <th class="py-2 pr-2">№</th>
          <th class="py-2 pr-2">Заказчик</th>
          <th class="py-2 pr-2">Пациент</th>
          <th class="py-2 pr-2">Статус</th>
          <th class="py-2 pr-2">Оплата</th>
          <th class="py-2 pr-2">Сумма оплаты</th>
          <th class="py-2 pr-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <% selectable = @batch_paid ? !order.customer_paid? : order.customer_paid? %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="py-2 pr-2">
              <% if selectable %>
                <%= check_box_tag "work_order_ids[]",
                                  order.id,
                                  false,
                                  id: "cpo_#{order.id}",
                                  data: {
                                    payment_line_select_target: "line",
                                    amount: order.customer_order_payment_amount.to_f,
                                    action: "change->payment-line-select#recalc"
                                  } %>
              <% end %>
            </td>
            <td class="py-2 pr-2">
              <% if selectable %>
                <label for="cpo_<%= order.id %>"><%= record_link("##{order.number}", work_order_path(order)) %></label>
              <% else %>
                <%= record_link("##{order.number}", work_order_path(order)) %>
              <% end %>
            </td>
            <td class="py-2 pr-2"><%= order.customer.name %></td>
            <td class="py-2 pr-2"><%= order.patient&.full_name || "—" %></td>
            <td class="py-2 pr-2"><%= work_order_status_badge(order) %></td>
            <td class="py-2 pr-2"><%= customer_paid_badge(order) %></td>
            <td class="py-2 pr-2">
              <% if order.customer_order_payment_amount.to_d.positive? %>
                <%= number_to_currency(order.customer_order_payment_amount) %>
                <% if order.customer_paid? %>
                  · <%= order.customer_paid_at&.strftime("%d.%m.%Y") %>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="py-2 pr-2"><%= open_record_link(work_order_path(order)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="flex flex-wrap gap-3">
      <% if @batch_paid %>
        <%= submit_tag "К подтверждению оплаты",
                       class: "rounded bg-emerald-800 px-4 py-2 text-white disabled:opacity-40",
                       data: { payment_line_select_target: "submit" } %>
      <% else %>
        <%= submit_tag "К подтверждению снятия оплаты",
                       class: "rounded border border-red-700 px-4 py-2 text-red-800 disabled:opacity-40",
                       data: { payment_line_select_target: "submit" } %>
      <% end %>
    </div>
  <% end %>
<% end %>

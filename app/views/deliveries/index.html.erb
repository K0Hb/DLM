<div class="mb-6">
  <h1 class="text-2xl font-semibold">Доставка</h1>
  <p class="text-slate-600 text-sm">Наряды в статусе ready</p>
</div>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b text-slate-500">
      <th class="py-2 pr-3">№</th>
      <th class="py-2 pr-3">Заказчик</th>
      <th class="py-2 pr-3">Пациент</th>
      <th class="py-2"></th>
    </tr>
  </thead>
  <tbody>
    <% @work_orders.each do |order| %>
      <tr class="border-b border-slate-100 hover:bg-slate-50">
        <td class="py-2 pr-3"><%= record_link("##{order.number}", work_order_path(order)) %></td>
        <td class="py-2 pr-3"><%= order.customer.name %></td>
        <td class="py-2 pr-3"><%= order.patient&.full_name || "—" %></td>
        <td class="py-2 pr-3 text-right space-x-2">
          <%= open_record_link(work_order_path(order)) %>
          <%= button_to "Отправлен", mark_sent_delivery_path(order), method: :post, class: "inline rounded bg-slate-900 px-3 py-1 text-white" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

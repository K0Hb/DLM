<%# locals: work_order %>
<% lines = work_order.assigned_service_lines %>
<% next_targets = work_order.advance_targets %>
<% blocked = work_order.status == "in_progress" && (lines.empty? || !work_order.all_services_completed?) %>

<section class="mb-4 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3.5 lg:max-w-none work-order-status-print" aria-labelledby="work-order-status-heading">
  <h2 id="work-order-status-heading" class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500 no-print">Статус</h2>

  <div class="flex gap-1 no-print" role="list">
    <% WorkOrder::STATUSES.each do |step| %>
      <% state = work_order_pipeline_step_state(work_order, step) %>
      <div class="h-1.5 flex-1 rounded-full <%= work_order_pipeline_segment_classes(state) %>"
           role="listitem"
           title="<%= work_order_status_label(step) %>"></div>
    <% end %>
  </div>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <%= work_order_status_badge(work_order) %>
      <% if next_targets.one? %>
        <span class="text-slate-400">→</span>
        <span class="text-slate-700"><%= work_order_status_label(next_targets.first) %></span>
      <% elsif next_targets.many? %>
        <span class="text-slate-400">→</span>
        <span class="text-slate-700"><%= next_targets.map { |t| work_order_status_label(t) }.join(" или ") %></span>
      <% elsif work_order.closed? %>
        <span class="text-slate-400">· финальный этап</span>
      <% end %>
    </div>

    <% if next_targets.any? %>
      <div class="flex flex-wrap gap-2 no-print">
        <% next_targets.each do |to| %>
          <%# Классы только здесь — Tailwind их видит при сборке %>
          <% btn_class = if next_targets.many? && to == "sent"
               "rounded-lg border-2 border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 shadow-sm hover:border-slate-400 hover:bg-slate-50"
             else
               "rounded-lg bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-900"
             end %>
          <%= button_to advance_work_order_path(work_order, to: to),
                        method: :post,
                        form: { class: "inline" },
                        class: btn_class do %>
            <%= WorkOrder::ADVANCE_LABELS[to] %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if blocked %>
    <p class="mt-2.5 text-xs text-amber-800 no-print">
      <% if lines.empty? %>
        Добавьте услуги ниже, чтобы перейти в «Готов».
      <% else %>
        Для «Готов» нужны все выполненные услуги (<%= lines.count(&:completed?) %>/<%= lines.size %>).
      <% end %>
    </p>
  <% end %>

  <details class="mt-2.5 text-xs text-slate-500 no-print">
    <summary class="cursor-pointer select-none hover:text-slate-800">
      Подробнее
    </summary>
    <div class="mt-2 space-y-2 border-l-2 border-slate-300 pl-3 text-slate-600">
      <p class="leading-relaxed">
        <% WorkOrder::STATUSES.each_with_index do |step, i| %>
          <% state = work_order_pipeline_step_state(work_order, step) %>
          <% if i.positive? %><span class="text-slate-300"> · </span><% end %>
          <span class="<%= state == :current ? "font-medium text-slate-900" : (state == :done ? "text-emerald-700" : "") %>">
            <%= work_order_status_label(step) %>
          </span>
        <% end %>
      </p>

      <% if work_order.rollback_targets.any? %>
        <div class="flex flex-wrap gap-2 pt-1">
          <% work_order.rollback_targets.each do |to| %>
            <%= button_to WorkOrder::ROLLBACK_LABELS[to],
                          rollback_work_order_path(work_order, to: to),
                          method: :post,
                          form: { data: { turbo_confirm: work_order_rollback_confirm(work_order, to) }, class: "inline" },
                          class: "text-red-700 underline hover:text-red-900" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>
</section>

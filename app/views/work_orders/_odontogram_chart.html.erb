<%# locals: readonly (boolean, default false) %>
<% readonly = local_assigns.fetch(:readonly, false) %>
<%
  upper = [18, 17, 16, 15, 14, 13, 12, 11, 21, 22, 23, 24, 25, 26, 27, 28]
  lower = [48, 47, 46, 45, 44, 43, 42, 41, 31, 32, 33, 34, 35, 36, 37, 38]

  arch_points = lambda do |numbers, cy, flip|
    n = numbers.size
    spacing = 46
    total = (n - 1) * spacing
    start_x = (800 - total) / 2.0
    numbers.each_with_index.map do |num, i|
      t = n == 1 ? 0.5 : i.to_f / (n - 1)
      arch = -Math.sin(t * Math::PI) * 28
      y = flip ? cy - arch : cy + arch
      x = start_x + i * spacing
      [num, x, y]
    end
  end

  upper_pts = arch_points.call(upper, 78, false)
  lower_pts = arch_points.call(lower, 210, true)
  all_pts = upper_pts + lower_pts
  point_for = all_pts.to_h { |num, x, y| [num, [x, y]] }
%>

<svg class="odontogram-svg<%= " odontogram-svg--readonly" if readonly %>" viewBox="0 0 800 290" role="img" aria-label="Зубная формула FDI">
  <defs>
    <filter id="odontogram-soft-<%= readonly ? "ro" : "ed" %>" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1" stdDeviation="1.2" flood-opacity="0.18"/>
    </filter>
    <linearGradient id="odontogram-gum-upper-<%= readonly ? "ro" : "ed" %>" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fbcfe8" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#fbcfe8" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="odontogram-gum-lower-<%= readonly ? "ro" : "ed" %>" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="#fbcfe8" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#fbcfe8" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="800" height="290" rx="16" fill="#eef2f6"/>
  <ellipse cx="400" cy="70" rx="360" ry="55" fill="url(#odontogram-gum-upper-<%= readonly ? "ro" : "ed" %>)"/>
  <ellipse cx="400" cy="220" rx="360" ry="55" fill="url(#odontogram-gum-lower-<%= readonly ? "ro" : "ed" %>)"/>

  <line x1="400" y1="18" x2="400" y2="272" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 5" opacity="0.7"/>
  <text x="56" y="148" text-anchor="middle" class="odontogram-side-label">R</text>
  <text x="744" y="148" text-anchor="middle" class="odontogram-side-label">L</text>

  <% [upper, lower].each do |arch| %>
    <% arch.each_cons(2) do |a, b| %>
      <% pa = point_for[a]; pb = point_for[b]; next unless pa && pb %>
      <g class="odontogram-connector"
         data-odontogram-target="connector"
         data-a="<%= a %>"
         data-b="<%= b %>"
         <% unless readonly %>
           data-action="click->odontogram#toggleConnector"
         <% end %>
         style="cursor: <%= readonly ? "default" : "pointer" %>; display: none;">
        <line x1="<%= pa[0] + 18 %>" y1="<%= pa[1] %>" x2="<%= pb[0] - 18 %>" y2="<%= pb[1] %>"
              stroke="#94a3b8" stroke-width="4" stroke-linecap="round" class="odontogram-connector-line"/>
        <circle cx="<%= (pa[0] + pb[0]) / 2.0 %>" cy="<%= (pa[1] + pb[1]) / 2.0 %>" r="7"
                fill="#cbd5e1" stroke="#64748b" stroke-width="1.5" class="odontogram-connector-dot"/>
      </g>
    <% end %>
  <% end %>

  <% all_pts.each do |n, x, y| %>
    <g class="odontogram-tooth"
       data-odontogram-target="tooth"
       data-n="<%= n %>"
       transform="translate(<%= x %>, <%= y %>)"
       <% unless readonly %>
         data-action="click->odontogram#toggle"
       <% end %>
       style="cursor: <%= readonly ? "default" : "pointer" %>">
      <title><%= n %></title>
      <path class="odontogram-tooth-body"
            d="M-16,-20
               C-16,-28 -10,-32 0,-32
               C10,-32 16,-28 16,-20
               L14,14
               C14,20 8,24 0,24
               C-8,24 -14,20 -14,14 Z"
            fill="#ffffff"
            stroke="#94a3b8"
            stroke-width="1.75"
            filter="url(#odontogram-soft-<%= readonly ? "ro" : "ed" %>)"/>
      <text class="odontogram-tooth-num" text-anchor="middle" y="4" dominant-baseline="middle"><%= n %></text>
    </g>
  <% end %>
</svg>

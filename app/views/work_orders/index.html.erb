<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">Наряды</h1>
  <%= link_to "Новый наряд", new_work_order_path, class: "rounded bg-slate-900 px-3 py-2 text-sm text-white" %>
</div>

<%= form_with url: work_orders_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3 text-sm" do %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="patient">Пациент (фамилия / ФИО)</label>
    <%= text_field_tag :patient, params[:patient], id: "patient", placeholder: "Сидорова", class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="status">Статус</label>
    <%= select_tag :status, options_for_select(work_order_status_options(include_blank: "Все статусы"), params[:status]), id: "status", class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="customer_id">Заказчик</label>
    <%= select_tag :customer_id, options_from_collection_for_select(Customer.order(:name), :id, :name, params[:customer_id]), include_blank: "Все заказчики", id: "customer_id", class: "rounded border px-2 py-1" %>
  </div>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="paid">Оплата</label>
    <%= select_tag :paid, options_for_select([["Оплата любая", ""], ["Оплачен", "yes"], ["Не оплачен", "no"]], params[:paid]), id: "paid", class: "rounded border px-2 py-1" %>
  </div>
  <%= submit_tag "Найти", class: "rounded bg-slate-800 px-3 py-1 text-white" %>
  <% if params[:patient].present? || params[:status].present? || params[:customer_id].present? || params[:paid].present? %>
    <%= link_to "Сбросить", work_orders_path, class: "underline self-center" %>
  <% end %>
<% end %>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b border-slate-200 text-slate-500">
      <th class="py-2 pr-3">№</th>
      <th class="py-2 pr-3">Статус</th>
      <th class="py-2 pr-3">Заказчик</th>
      <th class="py-2 pr-3">Пациент</th>
      <th class="py-2 pr-3">Срок</th>
      <th class="py-2 pr-3">Оплата</th>
      <th class="py-2 pr-3"></th>
    </tr>
  </thead>
  <tbody>
    <% if @work_orders.empty? %>
      <tr>
        <td colspan="7" class="py-6 text-slate-500">Наряды не найдены</td>
      </tr>
    <% else %>
      <% @work_orders.each do |order| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50 <%= 'bg-red-50' if order.due_at&.past? && !order.closed? %>">
          <td class="py-2 pr-3"><%= record_link("##{order.number}", work_order_path(order)) %></td>
          <td class="py-2 pr-3"><%= work_order_status_badge(order) %></td>
          <td class="py-2 pr-3"><%= order.customer.name %></td>
          <td class="py-2 pr-3"><%= order.patient&.full_name || "—" %></td>
          <td class="py-2 pr-3"><%= order.due_at&.strftime("%d.%m.%Y %H:%M") || "—" %></td>
          <td class="py-2 pr-3"><%= customer_paid_badge(order) %></td>
          <td class="py-2 pr-3"><%= open_record_link(work_order_path(order)) %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<%= render_pagination %>

<div class="work-order-print-sheet">
<div class="mb-4 flex flex-wrap items-start justify-between gap-4 work-order-print-header">
  <div class="min-w-0 flex-1 work-order-print-title">
    <h1 class="text-2xl font-semibold">Наряд №<%= @work_order.number %></h1>
    <% if @manage_work_order %>
      <%= render "status_controls", work_order: @work_order %>
    <% else %>
      <p class="mt-1 text-slate-600">Статус: <%= work_order_status_badge(@work_order) %></p>
    <% end %>
  </div>
  <div class="flex flex-wrap items-start gap-3 work-order-print-qr-wrap">
    <div class="work-order-qr work-order-qr--screen shrink-0 rounded border bg-white p-2 no-print">
      <%= work_order_qr_svg(@work_order, module_size: 5) %>
    </div>
    <div class="work-order-qr work-order-qr--print shrink-0 rounded border bg-white p-3 print-only">
      <%= work_order_qr_svg(@work_order, module_size: 8) %>
    </div>
    <div class="flex flex-wrap gap-2 text-sm no-print">
      <button type="button"
              onclick="window.print()"
              class="rounded border px-3 py-1 hover:bg-white">
        Печать
      </button>
      <% if @manage_work_order %>
        <%= link_to "Изменить", edit_work_order_path(@work_order), class: "rounded border px-3 py-1" %>
        <%= link_to "К списку", work_orders_path, class: "underline px-2 py-1" %>
      <% else %>
        <%= link_to "Мои задачи", my_tasks_path, class: "underline px-2 py-1" %>
      <% end %>
    </div>
  </div>
</div>

<div class="work-order-print-grid lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(20rem,32rem)] xl:grid-cols-[minmax(0,1fr)_minmax(24rem,36rem)] lg:items-start lg:gap-8 xl:gap-10">
  <div class="order-2 min-w-0 space-y-6 lg:order-1 work-order-print-main">
    <div class="grid gap-2 text-sm md:grid-cols-2 work-order-print-meta">
      <div>Заказчик: <%= @work_order.customer.name %></div>
      <div>Пациент: <%= @work_order.patient&.full_name || "—" %></div>
      <div>Врач: <%= @work_order.doctor&.full_name || "—" %></div>
      <div>Срок: <%= @work_order.due_at&.strftime("%d.%m.%Y %H:%M") || "—" %></div>
      <% if @manage_work_order %>
        <div class="md:col-span-2 space-y-2 no-print">
          <div>
            Оплата: <%= customer_paid_badge(@work_order) %>
            <% if @work_order.customer_paid? %>
              · <%= number_to_currency(@work_order.customer_paid_amount) %>
              (<%= @work_order.customer_paid_at&.strftime("%d.%m.%Y") %>)
            <% elsif @work_order.customer_payment_amount.to_d.positive? %>
              · к оплате: <%= number_to_currency(@work_order.customer_payment_amount) %>
            <% end %>
          </div>
          <div class="flex flex-wrap gap-3 text-sm">
            <% if @work_order.customer_paid? %>
              <%= link_to "Снять оплату заказчиком",
                          new_customer_payment_path(work_order_ids: [ @work_order.id ], paid: false, return_to: work_order_path(@work_order)),
                          class: "underline" %>
            <% else %>
              <%= link_to "Оплатить заказчиком",
                          new_customer_payment_path(work_order_ids: [ @work_order.id ], paid: true, return_to: work_order_path(@work_order)),
                          class: "underline" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="work-order-print-notes">
      <div class="font-medium">Описание</div>
      <div class="mt-1 whitespace-pre-wrap text-slate-700"><%= @work_order.notes.presence || "—" %></div>
    </div>

    <% if @manage_work_order %>
      <div class="rounded border bg-white p-4 no-print" data-controller="clipboard">
        <h2 class="mb-3 text-sm font-semibold">Публичная ссылка</h2>
        <div class="space-y-2 text-sm max-w-xl">
          <label class="block text-xs text-slate-500" for="public-url">Ссылка</label>
          <input id="public-url"
                 type="text"
                 readonly
                 data-clipboard-target="source"
                 value="<%= work_order_public_url(@work_order) %>"
                 class="w-full rounded border px-2 py-1 font-mono text-xs" />
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" data-action="click->clipboard#copy" class="rounded bg-slate-900 px-3 py-1 text-white">Копировать</button>
            <%= link_to "Открыть", work_order_public_url(@work_order), target: "_blank", rel: "noopener", class: "underline" %>
            <span data-clipboard-target="status" class="text-xs text-emerald-700"></span>
          </div>
        </div>
      </div>
    <% end %>

    <div class="work-order-print-services">
      <h2 class="mb-3 text-lg font-semibold">Услуги</h2>
      <% if @manage_work_order %>
        <% assignees_unpaid = @work_order.assigned_service_lines.reject(&:technician_paid?).select(&:payout_eligible?).group_by(&:assignee) %>
        <% if assignees_unpaid.any? %>
          <div class="mb-3 flex flex-wrap gap-2 text-sm no-print">
            <% assignees_unpaid.each do |assignee, lines| %>
              <%= link_to "Оплатить все: #{assignee.full_name}",
                          new_technician_payment_path(work_order_service_ids: lines.map(&:id), paid: true, return_to: work_order_path(@work_order)),
                          class: "rounded bg-emerald-800 px-3 py-1.5 text-white" %>
            <% end %>
          </div>
        <% elsif @work_order.draft? && @work_order.assigned_service_lines.any? %>
          <p class="mb-3 text-sm text-slate-500 no-print">Оплата сотруднику доступна после перевода наряда из черновика (например «В работу»).</p>
        <% end %>
      <% end %>
      <div class="overflow-x-auto">
        <table class="mb-4 w-full min-w-[40rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b text-slate-500">
              <th class="py-2 pr-2">Услуга</th>
              <th class="py-2 pr-2">Исполнитель</th>
              <th class="py-2 pr-2">Кол-во</th>
              <th class="py-2 pr-2 no-print">Ставка</th>
              <th class="py-2 pr-2">Статус</th>
              <th class="py-2 pr-2 no-print">Оплата сотруднику</th>
              <th class="py-2 no-print"></th>
            </tr>
          </thead>
          <tbody>
            <% @work_order.assigned_service_lines.each do |line| %>
              <tr class="border-b">
                <td class="py-2 pr-2"><%= line.service.name %></td>
                <td class="py-2 pr-2"><%= line.assignee.full_name %></td>
                <td class="py-2 pr-2"><%= line.quantity %></td>
                <td class="py-2 pr-2 no-print"><%= number_to_currency(line.technician_price_snapshot) %></td>
                <td class="py-2 pr-2"><%= service_line_status_badge(line) %></td>
                <td class="py-2 pr-2 no-print"><%= technician_paid_badge(line) %></td>
                <td class="py-2 text-right space-x-1 no-print">
                  <% if @manage_work_order %>
                    <% if line.assigned? %>
                      <%= button_to "В работу", start_work_order_work_order_service_path(@work_order, line), method: :post, class: "underline" %>
                    <% end %>
                    <% if line.in_progress? %>
                      <%= button_to "Выполнено", complete_work_order_work_order_service_path(@work_order, line), method: :post, class: "underline" %>
                      <%= button_to "← назначена", rollback_work_order_work_order_service_path(@work_order, line, to: "assigned"), method: :post, class: "underline" %>
                    <% end %>
                    <% if line.completed? %>
                      <%= button_to "← в работе", rollback_work_order_work_order_service_path(@work_order, line, to: "in_progress"), method: :post, class: "underline" %>
                    <% end %>
                    <% if line.payout_eligible? %>
                      <% if line.technician_paid? %>
                        <% unless line.payout_locked_for?(current_user) && !current_user.superadmin? %>
                          <%= link_to "Снять оплату",
                                      new_technician_payment_path(work_order_service_ids: [ line.id ], paid: false, return_to: work_order_path(@work_order)),
                                      class: "underline" %>
                        <% end %>
                      <% else %>
                        <%= link_to "Оплатить",
                                    new_technician_payment_path(work_order_service_ids: [ line.id ], paid: true, return_to: work_order_path(@work_order)),
                                    class: "rounded border border-emerald-700 px-2 py-0.5 text-xs text-emerald-800" %>
                      <% end %>
                    <% end %>
                    <% if @work_order.editable_structure? && policy(line).destroy? %>
                      <%= button_to line.deletable? ? "Удалить" : "Снять",
                                    work_order_work_order_service_path(@work_order, line),
                                    method: :delete,
                                    form: { data: { turbo_confirm: work_order_service_delete_confirm(line) }, class: "inline" },
                                    class: "text-red-700 underline" %>
                    <% end %>
                  <% elsif line.assignee_id == current_user.id %>
                    <%= open_record_link(my_task_path(line), label: "Моя задача") %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @manage_work_order && @work_order.editable_structure? %>
        <%= form_with model: [@work_order, @line],
                      class: "grid gap-3 md:grid-cols-4 xl:grid-cols-[2fr_2fr_6rem_auto] items-end text-sm no-print",
                      data: {
                        controller: "service-assignee",
                        service_assignee_map_value: @employee_ids_by_service.to_json
                      } do |f| %>
          <div>
            <%= f.label :service_id, "Услуга" %>
            <%= f.collection_select :service_id, @services, :id, :name, {},
                                    class: "mt-1 w-full rounded border px-2 py-1",
                                    required: true,
                                    data: { service_assignee_target: "service", action: "change->service-assignee#refresh" } %>
          </div>
          <div>
            <%= f.label :assignee_id, "Исполнитель" %>
            <%= f.collection_select :assignee_id, @employees, :id, :full_name, { prompt: "Выберите" },
                                    class: "mt-1 w-full rounded border px-2 py-1",
                                    required: true,
                                    data: { service_assignee_target: "assignee" } %>
          </div>
          <div>
            <%= f.label :quantity, "Кол-во" %>
            <%= f.number_field :quantity, value: 1, min: 1, class: "mt-1 w-full rounded border px-2 py-1" %>
          </div>
          <div>
            <%= f.submit "Добавить", class: "rounded bg-slate-900 px-3 py-2 text-white" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @manage_work_order %>
      <div class="no-print">
        <h2 class="mb-3 text-lg font-semibold">Фото наряда (до <%= WorkOrder.photos_limit %>)</h2>
        <% if @work_order.photos.attached? %>
          <div class="mb-4">
            <%= render "shared/photo_gallery",
                       photos: @work_order.photos,
                       purge_path_proc: ->(photo) { purge_photo_work_order_path(@work_order, photo_id: photo.id) } %>
          </div>
        <% end %>
        <%= form_with url: attach_photos_work_order_path(@work_order), method: :post, multipart: true, class: "flex flex-wrap items-end gap-3 text-sm" do %>
          <div>
            <%= file_field_tag "work_order[photos][]", multiple: true, accept: "image/jpeg,image/png,image/webp", class: "block" %>
            <p class="mt-1 text-xs text-slate-500">JPEG / PNG / WebP, до 10 МБ · клик по миниатюре — просмотр</p>
          </div>
          <%= submit_tag "Загрузить", class: "rounded bg-slate-800 px-3 py-2 text-white" %>
        <% end %>
      </div>
    <% elsif @work_order.photos.attached? %>
      <div class="no-print">
        <h2 class="mb-3 text-lg font-semibold">Фото наряда</h2>
        <%= render "shared/photo_gallery", photos: @work_order.photos, purge_path_proc: nil %>
      </div>
    <% end %>
  </div>

  <aside class="order-1 mb-6 min-w-0 overflow-hidden lg:order-2 lg:mb-0 lg:sticky lg:top-4 lg:self-start work-order-print-side">
    <%= render "shared/odontogram_readonly", work_order: @work_order, sidebar: true %>
  </aside>
</div>
</div>

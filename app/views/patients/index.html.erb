<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">Пациенты</h1>
  <%= link_to "Добавить", new_patient_path, class: "rounded bg-slate-900 px-3 py-2 text-sm text-white" %>
</div>

<%= form_with url: patients_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3 text-sm" do %>
  <div>
    <label class="mb-1 block text-xs text-slate-500" for="q">Поиск по ФИО</label>
    <%= text_field_tag :q, params[:q], id: "q", class: "rounded border px-2 py-1", placeholder: "Сидорова" %>
  </div>
  <%= submit_tag "Найти", class: "rounded bg-slate-800 px-3 py-1 text-white" %>
  <%= link_to "Сбросить", patients_path, class: "underline self-center" if params[:q].present? %>
<% end %>

<table class="w-full border-collapse text-left text-sm">
  <thead>
    <tr class="border-b border-slate-200 text-slate-500">
      <th class="py-2 pr-3">ФИО</th>
      <th class="py-2 pr-3">Врач</th>
      <th class="py-2 pr-3">Заказчик</th>
      <th class="py-2 pr-3">Нарядов</th>
      <th class="py-2"></th>
    </tr>
  </thead>
  <tbody>
    <% if @records.empty? %>
      <tr><td colspan="5" class="py-6 text-slate-500">Пациентов нет</td></tr>
    <% else %>
      <% @records.each do |record| %>
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="py-2 pr-3"><%= record_link(record.full_name, patient_path(record)) %></td>
          <td class="py-2 pr-3"><%= record.doctor.full_name %></td>
          <td class="py-2 pr-3"><%= record.customer&.name || "—" %></td>
          <td class="py-2 pr-3"><%= record.work_orders.size %></td>
          <td class="py-2 pr-3 text-right">
            <%= open_record_link(patient_path(record)) %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<%= render_pagination %>

<%# locals: photos, purge_path_proc (photo -> path) %>
<div data-controller="photo-lightbox" class="space-y-3">
  <div class="flex flex-wrap gap-3">
    <% photos.each do |photo| %>
      <% preview_url = rails_blob_path(photo, disposition: "inline") %>
      <% download_url = rails_blob_path(photo, disposition: "attachment") %>
      <div class="rounded border bg-white p-2 text-xs w-36">
        <button type="button"
                class="mb-2 block w-full cursor-zoom-in border-0 bg-transparent p-0"
                data-action="click->photo-lightbox#open"
                data-preview-url="<%= preview_url %>"
                data-preview-alt="<%= photo.filename %>">
          <%= image_tag photo, class: "mx-auto block h-28 w-auto max-w-full rounded", alt: photo.filename.to_s %>
        </button>
        <div class="flex flex-wrap gap-x-2 gap-y-1 no-print">
          <%= link_to "Скачать", download_url, class: "underline text-slate-700", download: photo.filename.to_s %>
          <% if purge_path_proc %>
            <%= button_to "Удалить", purge_path_proc.call(photo), method: :delete, class: "underline text-red-700", form: { class: "inline" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <dialog data-photo-lightbox-target="dialog"
          data-action="click->photo-lightbox#backdropClose"
          class="photo-lightbox no-print max-w-[min(96vw,56rem)] rounded-lg border-0 bg-transparent p-0 backdrop:bg-slate-900/70">
    <div class="relative rounded-lg bg-slate-950 p-3 shadow-xl">
      <button type="button"
              data-action="click->photo-lightbox#close"
              class="absolute right-3 top-3 rounded bg-white/90 px-2 py-1 text-xs font-medium text-slate-900">
        Закрыть
      </button>
      <img data-photo-lightbox-target="image" alt="" class="mx-auto max-h-[85vh] max-w-full rounded object-contain" />
    </div>
  </dialog>
</div>

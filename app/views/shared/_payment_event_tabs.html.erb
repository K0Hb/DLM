<%# locals: active (:technician or :customer) %>
<nav class="mb-6 flex flex-wrap gap-2 border-b border-slate-200 text-sm" aria-label="Журналы">
  <% technician_classes = active == :technician ? "border-b-2 border-slate-900 font-medium text-slate-900 -mb-px pb-2" : "pb-2 text-slate-600 hover:text-slate-900" %>
  <% customer_classes = active == :customer ? "border-b-2 border-slate-900 font-medium text-slate-900 -mb-px pb-2" : "pb-2 text-slate-600 hover:text-slate-900" %>
  <%= link_to "Журнал выплат сотрудникам", payment_events_path, class: technician_classes %>
  <% if current_user.admin_or_superadmin? %>
    <%= link_to "Журнал оплат заказчиков", customer_payment_events_path, class: customer_classes %>
  <% end %>
</nav>

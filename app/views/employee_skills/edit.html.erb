<h1 class="mb-2 text-2xl font-semibold">Пул услуг</h1>
<p class="mb-6 text-slate-600"><%= @employee.full_name %> (<%= @employee.email %>)</p>

<%= form_with url: employee_skill_path(@employee), method: :patch, class: "max-w-xl space-y-4" do %>
  <div class="space-y-2">
    <% @services.each do |service| %>
      <label class="flex items-center gap-2 text-sm">
        <%= check_box_tag "user[service_ids][]", service.id, @employee.service_ids.include?(service.id), id: "service_#{service.id}" %>
        <span><%= service.name %> — <%= number_to_currency(service.technician_price) %></span>
      </label>
    <% end %>
    <%= hidden_field_tag "user[service_ids][]", "" %>
  </div>
  <div class="flex gap-3">
    <%= submit_tag "Сохранить", class: "rounded bg-slate-900 px-4 py-2 text-sm text-white" %>
    <%= link_to "Отмена", employee_skills_path, class: "underline text-sm" %>
  </div>
<% end %>
